# Yarn Classic (the previous package manager for this repo) does not enforce
# peer dependency ranges, whereas npm v7+ does and will abort installs on any
# unmet peer. Several transitive dependencies in this tree declare peer ranges
# that predate React 18 (e.g. react-chartjs-2@2.x lists react <=17 as a peer)
# even though they work fine at runtime. Enabling legacy-peer-deps makes npm
# resolve dependencies the way Yarn Classic did, preserving the existing,
# known-good dependency tree during the migration from yarn to npm.
legacy-peer-deps=true
